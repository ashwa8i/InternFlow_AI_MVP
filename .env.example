# Copy to .env and fill in only if you want real integrations.
APP_NAME=InternFlow AI
DATABASE_URL=sqlite:///internflow.db
DEMO_MODE=true

# Optional Claude integration
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-haiku-latest

# Optional SMTP integration (Gmail requires an App Password when 2-Step Verification is enabled)
SMTP_HOST=ashwakesh@gmail.com
SMTP_PORT=587
SMTP_USERNAME=ashwakesh@gmail.com
SMTP_PASSWORD=djczkcxxbzgqgssz
SMTP_FROM_EMAIL=ashwakesh@gmail.com
SMTP_USE_TLS=true

# Optional cohort review meeting integration. Use an OAuth refresh token
# authorized for https://www.googleapis.com/auth/calendar.events.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_MEET_DURATION_MINUTES=30

# Set to a strong random value before using outside a local demo
APP_SECRET=change-this-for-local-demo
